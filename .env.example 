
# Base URL of the ABA Go Orchestrator. Used by the Next.js server (server-side)

# to proxy REST requests to the orchestrator, so the browser always talks to

# the same origin and no CORS issues arise.
#

# - Local development (no Docker): keep the default

# - Docker Compose: ORCHESTRATOR_URL=http://orchestrator:8080
ORCHESTRATOR_URL=http://localhost:8080

# WebSocket URL of the ABA Go Orchestrator. Used by the browser for live

# campaign updates. When unset, defaults to ws(s)://<current-hostname>:8080.
#

# In Docker Compose, publish the orchestrator's 8080 port to the host and

# leave this empty, OR set it explicitly:

# NEXT_PUBLIC_WS_URL=ws://localhost:8080
