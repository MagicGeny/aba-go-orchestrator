DATABASE_URL=postgres://evgenyushakov:newnew11@localhost:5432/aba_orchestrator?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SeaweedFS S3 API (port 8333). Used by the AWS S3 SDK for the S3 code path.
SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_S3_BUCKET=campaign-attachments
SEAWEED_S3_REGION=us-east-1
# Leave access/secret empty to use anonymous creds; required only if S3 auth is enabled.
SEAWEED_S3_ACCESS_KEY=
SEAWEED_S3_SECRET_KEY=
SEAWEED_S3_PUBLIC_BASE_URL=http://localhost:8888

# SeaweedFS HTTP fallback. Use the FILER on port 8888 (NOT 8080 - that's the orchestrator).
# The filer serves both uploads (POST /<bucket>/<filename>) and downloads (GET /<bucket>/<filename>).
SEAWEED_SUBMIT_URL=http://localhost:8888/campaign-attachments
# Skip S3 PutObject entirely; use the HTTP submit endpoint only.
SEAWEED_FORCE_HTTP_UPLOAD=true
# Public base URL used to build attachment URLs from filer responses.
# MUST be the filer (port 8888) because that's where the uploaded files are actually served.
SEAWEED_HTTP_PUBLIC_BASE_URL=http://localhost:8888
ORCHESTRATOR_URL=http://localhost:8080